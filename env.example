# Copy to ".env" (or set as OS env vars) and fill values.
# Never commit the real ".env".
#
# Database (local dev)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/license_portal
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Required: AES master key for encrypt/decrypt product secrets
LICENSE_PORTAL_MASTER_KEY=change-me

# Local profile: seed kullanıcıları + .env import (zorunlu local geliştirmede)
SPRING_PROFILES_ACTIVE=local
